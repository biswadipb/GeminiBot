# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
# Optional
GEMINI_MODEL=gemini-3.8-flash
# Optional: comma-separated group IDs whose members may use the bot (get it with /chatid in the group)
ALLOWED_CHAT_IDS=
# Optional: comma-separated user IDs allowed anywhere, incl. private chat (blank = anyone if both are blank)
ALLOWED_USER_IDS=
# Optional: backup models used when the main one is busy, and retries per model
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_RETRIES=3
# Optional: Upstash Redis REST credentials so memory survives restarts (free at upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: Tavily key for better /search results (free at tavily.com). Blank = DuckDuckGo
TAVILY_API_KEY=
# Optional: Pollinations secret key (sk_...) for /imagine, from enter.pollinations.ai. Blank = anonymous
POLLINATIONS_KEY=
POLLINATIONS_MODEL=black-forest-labs/flux.1-schnell
# Optional /imagine fallbacks when Pollinations is busy (free tiers)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
HF_TOKEN=
# Per-person usage limits (0 = unlimited). Admins (comma-separated user IDs) are exempt.
ADMIN_USER_IDS=
LIMIT_CHAT_DAILY=150
LIMIT_SEARCH_DAILY=10
LIMIT_SEARCH_MONTHLY=100
LIMIT_IMAGINE_DAILY=20
# Optional: names the bot answers to in groups (comma-separated, whole word, any case)
BOT_NAMES=Laden
