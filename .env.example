# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
# Optional
GEMINI_MODEL=gemini-3.8-flash
# Optional: comma-separated group IDs whose members may use the bot (get it with /chatid in the group)
ALLOWED_CHAT_IDS=
# Optional: comma-separated user IDs allowed anywhere, incl. private chat (blank = anyone if both are blank)
ALLOWED_USER_IDS=
# Optional: backup models used when the main one is busy, and retries per model
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_RETRIES=3
